local function unload()
	clearHitboxes()
	for _, d in pairs(espData) do espDestroy(d) end
	table.clear(espData)
	if hud then hud:Destroy() end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
end

